# Copy to .env and fill in. Never commit .env.
# Redis for Sidekiq (jobs and mail). Local default is shown. Use a private, password-protected Redis in production.
REDIS_URL=redis://localhost:6379/0
# Sidekiq threads per process (optional, default 5). Keep it below the database pool size.
# SIDEKIQ_CONCURRENCY=5
# Development mail goes to Mailpit (brew install mailpit, then run: mailpit). Inbox: http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
